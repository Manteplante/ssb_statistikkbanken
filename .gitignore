# Byte-compiled
__pycache__/
*.py[cod]

# Recorded API responses are test data, not artefacts; other JSON is noise.
# Keeping them tracked is what lets CI run the suite fully offline and a fresh
# clone work immediately (~44 KB of git objects).
*.json
!tests/fixtures/**/*.json

# Environments
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
dist/
build/
*.egg-info/
